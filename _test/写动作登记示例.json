{
  "_说明": "登记表**结构与字段示例**，不是可直接拿去跑的真表：carrierPath / writers 全是占位符（<DSH_HOME>、tools/example-*.mjs）。照这个形状写你自己的登记表，然后把 --registry 指过去。字段语义见 README「写动作登记」一节。",
  "meta": {
    "version": 1,
    "host": "example",
    "source": "hand-written example (structure only)",
    "floor": {
      "total": 6,
      "classes": { "A": 1, "B": 1, "C": 1, "derived": 1, "ops": 1, "out-of-scope": 1 }
    },
    "baseline": {
      "total": 6,
      "classes": { "A": 1, "B": 1, "C": 1, "derived": 1, "ops": 1, "out-of-scope": 1 },
      "note": "baseline = 你登记的**现值**；floor = 下限。两者都写清，校验器才判得了「改了登记表却没同步 baseline」。"
    },
    "outOfScope": [
      { "what": "内核写会话日志", "why": "不属于本项目源码", "owner": "upstream-release-window", "covers": ["W41"] },
      { "what": "跨机脚本写对端盘", "why": "本机读不到对端盘", "owner": "cross-host-owner", "covers": ["W11", "W18"] },
      { "what": "运行时动态拼路径", "why": "路径要等运行时才定，静态判不了", "owner": "unassigned", "covers": ["W06"] }
    ],
    "unjudgeable": []
  },
  "entries": [
    {
      "id": "W01",
      "class": "A",
      "instance": "local",
      "carrierPath": "<DSH_HOME>/data/app-state.json",
      "carrierKey": "local|<DSH_HOME>/data/app-state.json",
      "authority": "示例：状态文件由谁负责",
      "writers": ["<DSH_HOME>/tools/example-writer.mjs"],
      "rebuildCommand": null,
      "enumerate": true,
      "patterns": ["app-state.json"],
      "note": "文件级：认「写调用目标里出现 app-state.json」的模块"
    },
    {
      "id": "W02",
      "class": "B",
      "instance": "local",
      "carrierPath": "<DSH_HOME>/data/app-cache.json",
      "carrierKey": "local|<DSH_HOME>/data/app-cache.json",
      "authority": "示例：缓存文件",
      "writers": ["<DSH_HOME>/tools/example-writer.mjs"],
      "rebuildCommand": null,
      "enumerate": true,
      "exclude": ["EXAMPLE_ALLOWED_MARKER"],
      "note": "exclude 是「这个文件对本载体不算写者」的豁免；同载体多条条目时取并集"
    },
    {
      "id": "W03",
      "class": "C",
      "instance": "local",
      "carrierPath": "<DSH_HOME>/data/app.db#rows",
      "carrierKey": "local|<DSH_HOME>/data/app.db#rows",
      "authority": "示例：一张表被多个写动作写",
      "writerScope": "table",
      "writers": ["<DSH_HOME>/tools/example-table-writer.mjs"],
      "rebuildCommand": null,
      "enumerate": true,
      "note": "表级：carrierKey 带 #表名 + writerScope:'table' ⇒ 走 T1/T2/T3 三条信号"
    },
    {
      "id": "W04",
      "class": "derived",
      "instance": "local",
      "carrierPath": "<DSH_HOME>/data/app-index.db#entries",
      "carrierKey": "local|<DSH_HOME>/data/app-index.db#entries",
      "authority": "示例：可重建的派生库",
      "writerScope": "table",
      "writers": ["<DSH_HOME>/tools/example-rebuild.mjs"],
      "rebuildCommand": "node tools/example-rebuild.mjs --rebuild",
      "enumerate": true,
      "note": "derived 必须有可执行重建命令，否则结构红"
    },
    {
      "id": "W05",
      "class": "ops",
      "instance": "local",
      "carrierPath": "<DSH_HOME>/logs/ops.log",
      "carrierKey": "local|<DSH_HOME>/logs/ops.log",
      "authority": "示例：只追加的运维日志",
      "writers": ["<DSH_HOME>/tools/example-append.mjs"],
      "rebuildCommand": null,
      "enumerate": true,
      "note": "只追加日志也按写者登记，不然重构时容易被人悄悄改名"
    },
    {
      "id": "W06",
      "class": "out-of-scope",
      "instance": "local",
      "carrierPath": "<DSH_HOME>/internal/session-log",
      "carrierKey": "local|<DSH_HOME>/internal/session-log",
      "authority": "示例：不在本机判据内",
      "writers": [],
      "rebuildCommand": null,
      "enumerate": false,
      "note": "host:'peer' 或 class:'out-of-scope' 的条目必须在 meta.outOfScope 的 covers 里被认领，否则红"
    }
  ]
}
